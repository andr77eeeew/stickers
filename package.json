{
  "name": "tiktok-to-telegram-stickers",
  "version": "1.0.0",
  "description": "Offline-first local sticker importer and converter with opt-in DevTools capture.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "install-all": "npm install && npm install --prefix frontend",
    "test": "node --test test/**/*.test.js",
    "test:legacy-filter": "node test-sticker-filter.js",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "check": "npm run test && npm run lint && npm run build",
    "test:e2e": "npm run build && node --test test/e2e/*.e2e.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "stream-json": "^3.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.63.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
