# Local server
PORT=3001

# Required only for opt-in DevTools live capture.
# Generate a long random value locally, set the same value in the extension,
# and never commit the resulting .env file.
# INGEST_TOKEN=replace-with-a-long-random-local-secret

# Optional local paths. Leave unset to use the project output/temp folders.
# STICKER_OUTPUT_DIR=D:\path\to\sticker-library
# STICKER_TEMP_DIR=D:\path\to\temporary-files

# Additional dashboard origins for local development (comma-separated).
# The production dashboard is same-origin and Vite defaults are already allowed.
# DASHBOARD_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Byte and decoded-image limits
MAX_DECODED_PIXELS=67108864
MANUAL_FILE_MAX_BYTES=41943040
MANUAL_REQUEST_MAX_BYTES=167772160
HAR_MAX_BYTES=134217728

# DevTools ingest session budget. It starts at the first accepted unique asset.
SESSION_MAX_CAPTURES=25
SESSION_MAX_MS=1200000
CAPTURE_MIN_INTERVAL_MS=600
CAPTURE_JITTER_MS=800
INGEST_RATE_MAX=40